# ==========================================
# Dearly 서비스 환경 변수 설정 템플릿 (.env.example)
# ==========================================
# 실제 키 값은 이 파일이 아닌 .env 파일에 입력하세요.

# 1. OpenAI API 설정
# OpenAI API 대시보드(https://platform.openai.com/api-keys)에서 발급받은 비밀 키
OPENAI_API_KEY=your_openai_api_key_here
# 사용할 모델명 (권장: gpt-4o-mini 또는 gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# 2. Supabase 데이터베이스 설정
# Supabase 프로젝트 대시보드 -> Project Settings -> API 에서 확인 가능
# Project URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Project API Keys -> service_role 비밀 키 (절대 클라이언트에 노출하지 마세요)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. 로컬 서버 설정
PORT=3000
# 허용할 출처 (로컬 개발 시에는 * 또는 http://localhost:3000)
ALLOWED_ORIGIN=*

